{
  "manifest_version": 3,
  "name": "YT Live Chat Furigana",
  "version": "1.1.3",
  "version_name": "1.1.3",
  "description": "YouTube ライブの Super Chat / 通常チャット、StreamYard のステージコメントにひらがなルビ（非公式）。個別オン／オフ・スパチャのみ表示。端末内処理。字幕APIは使いません。",
  "homepage_url": "https://blackphi6.github.io/yt-furigana-extension/superchat.html",
  "permissions": ["storage"],
  "commands": {
    "toggle-hide-text-messages": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "MacCtrl+Shift+L"
      },
      "description": "スパチャのみ表示を切り替え"
    }
  },
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://streamyard.com/*",
    "*://www.streamyard.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YT Live Chat Furigana",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://streamyard.com/*",
        "*://www.streamyard.com/*"
      ],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dict/*"],
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://streamyard.com/*",
        "*://www.streamyard.com/*"
      ]
    }
  ]
}
