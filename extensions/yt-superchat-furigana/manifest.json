{
  "manifest_version": 3,
  "name": "YT Super Chat Furigana",
  "version": "1.0.2",
  "version_name": "1.0.2",
  "description": "YouTube ライブの Super Chat 本文にひらがなルビ（非公式）。端末内処理。読み未登録はクリックで登録。通常チャット・字幕APIは使いません。",
  "homepage_url": "https://blackphi6.github.io/yt-furigana-extension/superchat.html",
  "permissions": ["storage"],
  "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YT Super Chat Furigana",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dict/*"],
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"]
    }
  ]
}
