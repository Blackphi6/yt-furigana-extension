{
  "name": "furigana-ruby-engine",
  "version": "0.2.0",
  "description": "日本語テキストにひらがなルビ（<ruby>）を付けるエンジン。ブラウザ（拡張・Web）と Node で動く。kuromoji + 熟字訓・人名・駅名などの句辞書同梱",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.js"
    },
    "./dict/*": "./dict/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "dict/",
    "index.d.ts",
    "third_party/",
    "LICENSE",
    "COPYING",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/smoke.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "furigana",
    "ruby",
    "japanese",
    "kuromoji",
    "reading",
    "ふりがな",
    "ルビ"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blackphi6/yt-furigana-extension.git",
    "directory": "packages/furigana-ruby-engine"
  },
  "homepage": "https://github.com/Blackphi6/yt-furigana-extension/tree/main/packages/furigana-ruby-engine#readme",
  "bugs": {
    "url": "https://github.com/Blackphi6/yt-furigana-extension/issues"
  }
}
